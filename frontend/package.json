{
  "name": "kalpvruksh-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview --host",
    "dev:backend": "npm --prefix ../backend run dev",
    "dev:ai": "uvicorn main:app --port 8000 --reload --app-dir ../Ai-service",
    "dev:all": "npx concurrently \"vite --host\" \"npm --prefix ../backend run dev\" \"uvicorn main:app --host 0.0.0.0 --port 8000 --reload --app-dir ../Ai-service\""
  },
  "dependencies": {
    "lucide-react": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@tailwindcss/vite": "^4.0.9",
    "tailwindcss": "^4.0.9",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^6.2.0"
  }
}
